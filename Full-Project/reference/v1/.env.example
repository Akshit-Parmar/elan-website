# ============================================================================
# Élan — SECRET / server-side values ONLY.
# These are NOT used by the static site. They belong to Phase 2 (payments,
# server-side logic) and must be set as Cloudflare Worker / Supabase Edge
# Function secrets — never committed, never shipped to the browser.
#
# The PUBLIC Supabase URL + anon key live in public/assets/js/config.js instead.
# ============================================================================

# Supabase service_role key (bypasses RLS — server-side only, e.g. admin exports)
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Phase 2 — instant ticket checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
